# Copy this file to .env for local development. Never commit real secrets.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Local Docker database defaults; change passwords before any shared/production use.
POSTGRES_DB=alqadr_ota
POSTGRES_USER=alqadr
POSTGRES_PASSWORD=replace_this_local_password
DATABASE_URL=postgresql://alqadr:replace_this_local_password@localhost:5432/alqadr_ota?schema=public
DIRECT_DATABASE_URL=postgresql://alqadr:replace_this_local_password@localhost:5432/alqadr_ota?schema=public
REDIS_URL=redis://localhost:6379

# Add real secrets only to your hosting provider's environment-variable settings.
AUTH_ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_bytes
AUTH_REFRESH_TOKEN_SECRET=replace_with_a_different_32_byte_secret
SUPPLIER_CREDENTIALS_MASTER_KEY=
